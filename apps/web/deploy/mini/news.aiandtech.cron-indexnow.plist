<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Vercel cron replacement; load ONLY while the mini serves www.aiandtech.news. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>news.aiandtech.cron-indexnow</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/ozankasikci/aiandtechnews/bin/web-cron.sh</string>
    <string>indexnow</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/ozankasikci/aiandtechnews/logs/cron-indexnow.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ozankasikci/aiandtechnews/logs/cron-indexnow.log</string>
</dict>
</plist>
