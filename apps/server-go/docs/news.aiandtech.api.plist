<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the Go API on the Mac mini (template; see docs/cutover.md).

  Replace __RUNTIME__ with the absolute runtime directory on the internal disk
  (/Users/ozankasikci/aiandtechnews). It holds .technews-production,
  technews.env (600), bin/, data/, and logs/. launchd jobs cannot read the
  external build drive, so nothing here may point at /Volumes.

    cp news.aiandtech.api.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/news.aiandtech.api.plist
    launchctl kickstart -k gui/$(id -u)/news.aiandtech.api   # restart
    launchctl bootout gui/$(id -u)/news.aiandtech.api        # stop

  Secrets stay in technews.env, not in this file.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>news.aiandtech.api</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>set -a; . "__RUNTIME__/technews.env"; set +a; exec "__RUNTIME__/bin/api"</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__RUNTIME__</string>
  <!-- Restart whenever the process exits, while the env file exists. -->
  <key>KeepAlive</key>
  <dict>
    <key>PathState</key>
    <dict>
      <key>__RUNTIME__/technews.env</key>
      <true/>
    </dict>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <!-- SIGTERM starts a graceful shutdown (HTTP drain, then up to 15s for
       newsletter work to record its outcome); SIGKILL only after 60s. -->
  <key>ExitTimeOut</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>__RUNTIME__/logs/api.log</string>
  <key>StandardErrorPath</key>
  <string>__RUNTIME__/logs/api.err.log</string>

  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>4096</integer>
  </dict>
</dict>
</plist>
