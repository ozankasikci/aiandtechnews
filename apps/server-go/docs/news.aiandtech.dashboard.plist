<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the dashboard (apps/dashboard, Next standalone build) on the
  Mac mini (template; see docs/cutover.md). It listens on 127.0.0.1:3001 only
  and proxies /api to the Go API on 127.0.0.1:4001. Open it through
  `ssh -L 3001:127.0.0.1:3001 ozankasikci@kasikcis-mac-mini.local`.

  Replace __RUNTIME__ with the absolute runtime directory
  (/Users/ozankasikci/aiandtechnews). It holds node/ (the Node runtime) and
  dashboard/ (a copy of apps/dashboard/.next/standalone, with .next/static
  copied into dashboard/apps/dashboard/.next/static).

    cp news.aiandtech.dashboard.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/news.aiandtech.dashboard.plist
    launchctl kickstart -k gui/$(id -u)/news.aiandtech.dashboard   # after a new build
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>news.aiandtech.dashboard</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOSTNAME</key>
    <string>127.0.0.1</string>
    <key>PORT</key>
    <string>3001</string>
    <key>NODE_ENV</key>
    <string>production</string>
  </dict>

  <key>ProgramArguments</key>
  <array>
    <string>__RUNTIME__/node/bin/node</string>
    <string>__RUNTIME__/dashboard/apps/dashboard/server.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__RUNTIME__/dashboard/apps/dashboard</string>
  <!-- Restart whenever the process exits, while the build is in place. -->
  <key>KeepAlive</key>
  <dict>
    <key>PathState</key>
    <dict>
      <key>__RUNTIME__/dashboard/apps/dashboard/server.js</key>
      <true/>
    </dict>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__RUNTIME__/logs/dashboard.log</string>
  <key>StandardErrorPath</key>
  <string>__RUNTIME__/logs/dashboard.err.log</string>
</dict>
</plist>
