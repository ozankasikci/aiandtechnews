# Production environment for the Go API on the Mac mini. NAMES ONLY: fill in
# the values on the mini, never commit them. Installed as
# ~/aiandtechnews/technews.env with `chmod 600`. The API LaunchAgent loads it
# with `set -a; . technews.env`, so it must be valid POSIX sh that also loads
# under `set -u`. Single-quote every value: NAME='value' (a ' inside is
# written '\''). An unquoted value containing $ once broke loading. After
# every edit run the names-only check in docs/cutover.md (under `set -eu`);
# never print the file. An empty value means "not set": the documented
# default applies (or the setting is off).

# --- Runtime (required) -----------------------------------------------------
APP_ENV=production
# 127.0.0.1:4001 keeps the port the Node API used: the dashboard on the Mac
# mini proxies /api to it (apps/dashboard/next.config.ts).
SERVER_ADDR=127.0.0.1:4001
# Absolute paths inside the directory that holds .technews-production.
# Example: DATABASE_PATH='/Users/ozankasikci/aiandtechnews/data/technews.db'
#          UPLOADS_DIR='/Users/ozankasikci/aiandtechnews/data/uploads'
DATABASE_PATH=
UPLOADS_DIR=
# Same zone as the Node host (offset-less dashboard dates are read in it).
# Required in production.
TZ=Europe/Istanbul
# Copied from the MacBook's Node environment without printing it, so editor
# sessions stayed valid. Production refuses
# a value shorter than 32 bytes and Node's public fallback secret; in that
# case use `openssl rand -hex 32` and editors sign in again.
JWT_SECRET=

# --- Newsletter (copy from the Node environment) ---------------------------
NEWSLETTER_SITE_URL=
NEWSLETTER_TOKEN_SECRET=
NEWSLETTER_CRON_SECRET=
CRON_SECRET=
RESEND_API_KEY=
NEWSLETTER_FROM=
NEWSLETTER_REPLY_TO=

# --- Media ------------------------------------------------------------------
MEDIA_STORAGE=local
MEDIA_S3_PREFIX=

# --- Newsroom: collector on; publisher and IndexNow stay off until the -----
# --- Gemini, AWS, and S3 values below are filled in (one flag at a time) ----
COLLECTOR_ENABLED=1
COLLECTOR_INTERVAL=
PUBLISHER_ENABLED=0
PUBLISHER_INTERVAL=
INDEXNOW_ENABLED=0

# --- Publisher (required once PUBLISHER_ENABLED=1) --------------------------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# 1K, 2K or 4K; lite image models only support 1K.
GEMINI_IMAGE_SIZE=1K
# Legacy switch: generate (= FEATURED_IMAGE_CHAIN=gemini) or source
# (= FEATURED_IMAGE_CHAIN=source, copy the source article's image to S3).
# FEATURED_IMAGE_CHAIN wins when both are set.
FEATURED_IMAGE_SOURCE=source
# Featured-image providers tried in order: codex (Codex CLI image generation
# on the ChatGPT plan), gemini (GEMINI_IMAGE_MODEL), source (the source image).
# Each generated image passes the Gemini compliance review; a provider that
# fails or whose images are rejected hands over to the next one.
# Example: FEATURED_IMAGE_CHAIN=codex,gemini,source
FEATURED_IMAGE_CHAIN=
# Analyzers that write the art brief (codex, gemini), tried in order. Empty
# means the chain's codex and gemini entries in chain order.
FEATURED_IMAGE_ANALYZER=
# Required when the chain or analyzers include codex. Absolute paths on the
# internal disk (LaunchAgents cannot read the external SSD). Codex uses the
# ChatGPT login in ~/.codex of the user the job runs as (HOME), never an API
# key. Re-login: ~/aiandtechnews/tools/codex/node_modules/.bin/codex login --device-auth
CODEX_BIN=/Users/ozankasikci/aiandtechnews/tools/codex/node_modules/.bin/codex
# Directory holding the node binary codex needs on PATH.
CODEX_NODE_DIR=/Users/ozankasikci/aiandtechnews/node/bin
# One codex run's limit (default 4m, minimum 30s).
CODEX_TIMEOUT=
# The Vision cut-out tool (tools/cutout) for the public-figure collage.
# Empty disables the collage.
CUTOUT_BIN=/Users/ozankasikci/aiandtechnews/bin/cutout
GEMINI_VISION_MODEL=
AWS_REGION=
# Credentials come from the default AWS chain, for example a profile in
# ~/.aws/credentials of the user the job runs as.
AWS_PROFILE=
S3_FEATURE_IMAGE_BUCKET=
S3_FEATURE_IMAGE_PREFIX=
S3_FEATURE_IMAGE_PUBLIC_URL=
