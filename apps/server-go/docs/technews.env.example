# Production environment for the Go API on the Mac mini. NAMES ONLY: fill in
# the values on the Mac mini, never commit them. Install as
# <root>/technews.env with `chmod 600`. The launchd job loads it with
# `set -a; . technews.env`, so this is POSIX sh syntax: quote values that
# contain spaces or shell characters ("AI & Tech News <news@aiandtech.news>").
# docs/cutover.md says where each value comes from. An empty value means
# "not set": the documented default applies (or the setting is off).

# --- Runtime (required) -----------------------------------------------------
APP_ENV=production
# 127.0.0.1:4001 keeps the port the Node API used: the dashboard on the Mac
# mini proxies /api to it (apps/dashboard/next.config.ts).
SERVER_ADDR=127.0.0.1:4001
# Absolute paths inside the directory that holds .technews-production.
DATABASE_PATH=
UPLOADS_DIR=
# Same zone as the Node host (offset-less dashboard dates are read in it).
# Required in production.
TZ=Europe/Istanbul
# Copied from the MacBook's Node environment without printing it
# (docs/cutover.md step 2), so editor sessions stay valid. Production refuses
# a value shorter than 32 bytes and Node's public fallback secret; in that
# case use `openssl rand -hex 32` and editors sign in again.
JWT_SECRET=

# --- Newsletter (copy from the Node environment) ---------------------------
NEWSLETTER_SITE_URL=
NEWSLETTER_TOKEN_SECRET=
NEWSLETTER_CRON_SECRET=
CRON_SECRET=
RESEND_API_KEY=
NEWSLETTER_FROM=
NEWSLETTER_REPLY_TO=

# --- Media ------------------------------------------------------------------
MEDIA_STORAGE=local
MEDIA_S3_PREFIX=

# --- Newsroom: keep all three off at cutover, enable one at a time later ----
COLLECTOR_ENABLED=0
COLLECTOR_INTERVAL=
PUBLISHER_ENABLED=0
PUBLISHER_INTERVAL=
INDEXNOW_ENABLED=0

# --- Publisher (required once PUBLISHER_ENABLED=1) --------------------------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=
GEMINI_VISION_MODEL=
AWS_REGION=
# Credentials come from the default AWS chain, for example a profile in
# ~/.aws/credentials of the user the job runs as.
AWS_PROFILE=
S3_FEATURE_IMAGE_BUCKET=
S3_FEATURE_IMAGE_PREFIX=
S3_FEATURE_IMAGE_PUBLIC_URL=
